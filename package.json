{
  "name": "feeflow-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "test:frontend": "npm run test --workspace frontend",
    "migrate:fee-ledger": "npm run migrate:fee-ledger --workspace backend",
    "test": "npm run test --workspace backend",
    "seed": "npm run seed --workspace backend",
    "build": "npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
