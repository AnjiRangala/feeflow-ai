# Safe local examples only. Replace secrets and all localhost values before production.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/feeflow_ai?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=2h
OTP_HMAC_SECRET=replace-with-a-different-random-secret-at-least-32-characters
OTP_EXPIRES_MINUTES=5
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=5000
AI_SERVICE_TOKEN=replace-with-a-random-private-service-token-at-least-32-characters
# Use razorpay only with sandbox credentials outside local mock testing.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Keep true only for local synthetic testing; set false in production.
MOCK_PAYMENTS_ENABLED=true
REFUND_POLICY_VERSION=demo-pro-rata-v1
REMINDER_SCHEDULE_OFFSETS_DAYS=3,0,-3,-7,-15
REMINDER_POLL_INTERVAL_MS=60000
REMINDER_CATCH_UP_WINDOW_MS=86400000
REMINDER_STALE_SENDING_TIMEOUT_MS=300000
REMINDER_RETRY_DELAYS_MS=60000,300000,900000
RECEIPT_GST_NOTE=Not configured. No GST has been calculated or collected. Project assumption only; not a statement of tax applicability.
# Local SMTP is intentionally blank. Production must use a managed provider over TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DEMO_PARENT_PASSWORD=replace-with-a-local-demo-password
DEMO_ACCOUNTS_PASSWORD=replace-with-a-local-demo-password
DEMO_COUNSELLOR_PASSWORD=
